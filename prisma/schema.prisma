generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ATTORNEY
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DealType {
  ACQUISITION
  DISPOSITION
}

enum DealStatus {
  DRAFT
  ACTIVE
  UNDER_CONTRACT
  IN_DUE_DILIGENCE
  PENDING_CLOSING
  CLOSED
  TERMINATED
  ON_HOLD
}

enum PropertyType {
  OFFICE
  RETAIL
  INDUSTRIAL
  MULTIFAMILY
  MIXED_USE
  LAND
  HOSPITALITY
  HEALTHCARE
  SELF_STORAGE
  DATA_CENTER
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  WAIVED
  NOT_APPLICABLE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentCategory {
  CONTRACT
  AMENDMENT
  DUE_DILIGENCE
  TITLE
  SURVEY
  ENVIRONMENTAL
  FINANCIAL
  LEGAL
  CORRESPONDENCE
  CLOSING
  OTHER
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          UserRole   @default(CLIENT)
  status        UserStatus @default(PENDING)
  avatar        String?
  phone         String?
  title         String?

  firmId        String?
  firm          Firm?      @relation(fields: [firmId], references: [id])

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  createdDeals  Deal[]    @relation("CreatedBy")
  assignedTasks Task[]    @relation("AssignedTo")
  createdTasks  Task[]    @relation("TaskCreatedBy")
  documents     Document[]
}

model Firm {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  website     String?
  logo        String?

  users       User[]
  clients     Client[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  name        String
  type        String?
  address     String?
  phone       String?
  email       String?
  website     String?

  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id])

  deals       Deal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id              String       @id @default(cuid())
  name            String
  dealNumber      String       @unique
  type            DealType
  status          DealStatus   @default(DRAFT)

  propertyName    String?
  propertyType    PropertyType?
  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?
  propertyCounty  String?

  acreage         Decimal?     @db.Decimal(10, 4)
  squareFootage   Decimal?     @db.Decimal(12, 2)
  lotCount        Int?
  unitCount       Int?

  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])

  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  closedAt        DateTime?

  transactionSummary TransactionSummary?
  timeline        Timeline?
  tasks           Task[]
  documents       Document[]

  @@index([clientId])
  @@index([status])
  @@index([createdById])
}

model TransactionSummary {
  id                  String    @id @default(cuid())

  dealId              String    @unique
  deal                Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contractDate        DateTime?
  effectiveDate       DateTime?

  buyerName           String?
  buyerEntity         String?
  buyerAddress        String?
  sellerName          String?
  sellerEntity        String?
  sellerAddress       String?

  purchasePrice       Decimal?  @db.Decimal(14, 2)
  pricePerUnit        Decimal?  @db.Decimal(14, 2)
  priceAdjustable     Boolean   @default(false)
  priceAdjustmentBasis String?

  initialDeposit      Decimal?  @db.Decimal(14, 2)
  initialDepositDue   DateTime?
  additionalDeposits  Json?

  feasibilityPeriodDays Int?
  feasibilityExpiration DateTime?
  closingDate         DateTime?
  outsideClosingDate  DateTime?

  contingencies       Json?
  dueDiligenceItems   Json?
  closingDocuments    Json?
  specialProvisions   Json?

  titleCompany        String?
  escrowAgent         String?
  surveyRequirements  String?

  prorationDate       DateTime?
  prorationItems      Json?

  rawAnalysis         Json?
  version             Int       @default(1)
  analyzedAt          DateTime  @default(now())

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Timeline {
  id          String      @id @default(cuid())

  dealId      String      @unique
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  milestones  Milestone[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id              String          @id @default(cuid())

  timelineId      String
  timeline        Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  parentId        String?
  parent          Milestone?      @relation("MilestoneHierarchy", fields: [parentId], references: [id])
  children        Milestone[]     @relation("MilestoneHierarchy")

  name            String
  description     String?
  dueDate         DateTime
  completedDate   DateTime?
  status          MilestoneStatus @default(PENDING)

  isAutoGenerated Boolean         @default(false)
  sourceType      String?
  sourceReference String?

  sortOrder       Int             @default(0)
  reminderDays    Int[]

  tasks           Task[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([timelineId])
  @@index([parentId])
  @@index([dueDate])
}

model Task {
  id              String        @id @default(cuid())

  dealId          String
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  milestoneId     String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id])

  parentId        String?
  parent          Task?         @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks        Task[]        @relation("TaskHierarchy")

  title           String
  description     String?       @db.Text

  status          TaskStatus    @default(TODO)
  priority        TaskPriority  @default(MEDIUM)

  dueDate         DateTime?
  startDate       DateTime?
  completedAt     DateTime?

  assigneeId      String?
  assignee        User?         @relation("AssignedTo", fields: [assigneeId], references: [id])

  createdById     String
  createdBy       User          @relation("TaskCreatedBy", fields: [createdById], references: [id])

  category        String?
  tags            String[]
  customFields    Json?

  sortOrder       Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dealId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

model DocumentFolder {
  id          String           @id @default(cuid())

  dealId      String

  parentId    String?
  parent      DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    DocumentFolder[] @relation("FolderHierarchy")

  name        String
  description String?

  documents   Document[]

  sortOrder   Int              @default(0)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dealId])
  @@index([parentId])
}

model Document {
  id                String           @id @default(cuid())

  dealId            String
  deal              Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)

  folderId          String?
  folder            DocumentFolder?  @relation(fields: [folderId], references: [id])

  name              String
  originalName      String
  description       String?

  category          DocumentCategory @default(OTHER)
  subcategory       String?

  fileType          String
  fileSize          Int
  fileUrl           String
  fileKey           String

  version           Int              @default(1)
  previousVersionId String?
  previousVersion   Document?        @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  newerVersions     Document[]       @relation("DocumentVersions")

  uploadedById      String
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])

  isAnalyzed        Boolean          @default(false)
  isPrimaryContract Boolean          @default(false)

  sortOrder         Int              @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([dealId])
  @@index([category])
  @@index([folderId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
