generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ATTORNEY
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DealType {
  ACQUISITION
  DISPOSITION
}

enum DealStatus {
  DRAFT
  ACTIVE
  UNDER_CONTRACT
  IN_DUE_DILIGENCE
  PENDING_CLOSING
  CLOSED
  TERMINATED
  ON_HOLD
}

enum PropertyType {
  OFFICE
  RETAIL
  INDUSTRIAL
  MULTIFAMILY
  MIXED_USE
  LAND
  HOSPITALITY
  HEALTHCARE
  SELF_STORAGE
  DATA_CENTER
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  WAIVED
  NOT_APPLICABLE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentCategory {
  CONTRACT
  AMENDMENT
  DUE_DILIGENCE
  TITLE
  SURVEY
  ENVIRONMENTAL
  FINANCIAL
  LEGAL
  CORRESPONDENCE
  CLOSING
  OTHER
}

enum DepositStatus {
  SCHEDULED
  DUE
  PAID
  APPLIED_TO_PURCHASE
  REFUNDED
  FORFEITED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationFrequency {
  REALTIME
  DAILY
  WEEKLY
  NONE
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          UserRole   @default(CLIENT)
  status        UserStatus @default(PENDING)
  avatar        String?
  phone         String?
  title         String?

  firmId        String?
  firm          Firm?      @relation(fields: [firmId], references: [id])

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  createdDeals  Deal[]    @relation("CreatedBy")
  assignedTasks Task[]    @relation("AssignedTo")
  createdTasks  Task[]    @relation("TaskCreatedBy")
  taskComments  TaskComment[]
  documents     Document[]
  notes         Note[]
  issues        Issue[]
  preferences   UserPreferences?
  notifications Notification[]
}

model Firm {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  website     String?
  logo        String?

  users       User[]
  clients     Client[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  name        String
  type        String?
  address     String?
  phone       String?
  email       String?
  website     String?

  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id])

  deals       Deal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id              String       @id @default(cuid())
  name            String
  dealNumber      String       @unique
  type            DealType
  status          DealStatus   @default(DRAFT)

  propertyName    String?
  propertyType    PropertyType?
  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?
  propertyCounty  String?

  acreage         Decimal?     @db.Decimal(10, 4)
  squareFootage   Decimal?     @db.Decimal(12, 2)
  lotCount        Int?
  unitCount       Int?

  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])

  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  closedAt        DateTime?

  transactionSummary TransactionSummary?
  timeline        Timeline?
  taskLists       TaskList[]
  tasks           Task[]
  documents       Document[]
  notes           Note[]
  issues          Issue[]
  financials      DealFinancials?

  @@index([clientId])
  @@index([status])
  @@index([createdById])
}

model TransactionSummary {
  id                  String    @id @default(cuid())

  dealId              String    @unique
  deal                Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contractDate        DateTime?
  effectiveDate       DateTime?

  buyerName           String?
  buyerEntity         String?
  buyerAddress        String?
  sellerName          String?
  sellerEntity        String?
  sellerAddress       String?

  purchasePrice       Decimal?  @db.Decimal(14, 2)
  pricePerUnit        Decimal?  @db.Decimal(14, 2)
  priceAdjustable     Boolean   @default(false)
  priceAdjustmentBasis String?

  initialDeposit      Decimal?  @db.Decimal(14, 2)
  initialDepositDue   DateTime?
  additionalDeposits  Json?

  feasibilityPeriodDays Int?
  feasibilityExpiration DateTime?
  closingDate         DateTime?
  outsideClosingDate  DateTime?

  contingencies       Json?
  dueDiligenceItems   Json?
  closingDocuments    Json?
  specialProvisions   Json?

  titleCompany        String?
  escrowAgent         String?
  surveyRequirements  String?

  prorationDate       DateTime?
  prorationItems      Json?

  rawAnalysis         Json?
  version             Int       @default(1)
  analyzedAt          DateTime  @default(now())

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Timeline {
  id          String      @id @default(cuid())

  dealId      String      @unique
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  milestones  Milestone[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id              String          @id @default(cuid())

  timelineId      String
  timeline        Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  parentId        String?
  parent          Milestone?      @relation("MilestoneHierarchy", fields: [parentId], references: [id])
  children        Milestone[]     @relation("MilestoneHierarchy")

  name            String
  description     String?
  dueDate         DateTime
  completedDate   DateTime?
  status          MilestoneStatus @default(PENDING)

  isAutoGenerated Boolean         @default(false)
  sourceType      String?
  sourceReference String?

  sortOrder       Int             @default(0)
  reminderDays    Int[]

  tasks           Task[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([timelineId])
  @@index([parentId])
  @@index([dueDate])
}

model TaskList {
  id          String    @id @default(cuid())

  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String?
  sortOrder   Int       @default(0)
  isCollapsed Boolean   @default(false)

  tasks       Task[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dealId])
}

model Task {
  id              String        @id @default(cuid())

  dealId          String
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  taskListId      String?
  taskList        TaskList?     @relation(fields: [taskListId], references: [id], onDelete: SetNull)

  milestoneId     String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id])

  issueId         String?
  issue           Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  parentId        String?
  parent          Task?         @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks        Task[]        @relation("TaskHierarchy")

  title           String
  description     String?       @db.Text

  status          TaskStatus    @default(TODO)
  priority        TaskPriority  @default(MEDIUM)

  dueDate         DateTime?
  startDate       DateTime?
  completedAt     DateTime?

  assigneeId      String?
  assignee        User?         @relation("AssignedTo", fields: [assigneeId], references: [id])

  createdById     String
  createdBy       User          @relation("TaskCreatedBy", fields: [createdById], references: [id])

  category        String?
  tags            String[]
  customFields    Json?

  sortOrder       Int           @default(0)

  comments        TaskComment[]
  documents       Document[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dealId])
  @@index([taskListId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([issueId])
}

model TaskComment {
  id          String    @id @default(cuid())

  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  content     String    @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model DocumentFolder {
  id          String           @id @default(cuid())

  dealId      String

  parentId    String?
  parent      DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    DocumentFolder[] @relation("FolderHierarchy")

  name        String
  description String?

  documents   Document[]

  sortOrder   Int              @default(0)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dealId])
  @@index([parentId])
}

model Document {
  id                String           @id @default(cuid())

  dealId            String
  deal              Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)

  folderId          String?
  folder            DocumentFolder?  @relation(fields: [folderId], references: [id])

  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id])

  issueId           String?
  issue             Issue?           @relation(fields: [issueId], references: [id], onDelete: SetNull)

  name              String
  originalName      String
  description       String?

  category          DocumentCategory @default(OTHER)
  subcategory       String?

  fileType          String
  fileSize          Int
  fileUrl           String
  fileKey           String

  version           Int              @default(1)
  previousVersionId String?
  previousVersion   Document?        @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  newerVersions     Document[]       @relation("DocumentVersions")

  uploadedById      String
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])

  isAnalyzed        Boolean          @default(false)
  analysisResult    Json?
  analyzedAt        DateTime?
  isPrimaryContract Boolean          @default(false)

  sortOrder         Int              @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([dealId])
  @@index([category])
  @@index([folderId])
  @@index([taskId])
  @@index([issueId])
}

model Note {
  id          String    @id @default(cuid())

  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  issueId     String?
  issue       Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)

  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  title       String?
  content     String    @db.Text
  plainText   String?   @db.Text

  isPinned    Boolean   @default(false)

  category    String?
  tags        String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dealId])
  @@index([issueId])
  @@index([authorId])
}

model Issue {
  id          String        @id @default(cuid())

  dealId      String
  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  authorId    String
  author      User          @relation(fields: [authorId], references: [id])

  title       String
  description String?       @db.Text

  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)

  resolvedAt  DateTime?
  resolvedById String?

  tasks       Task[]
  notes       Note[]
  documents   Document[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([dealId])
  @@index([authorId])
  @@index([status])
}

model DealFinancials {
  id                    String    @id @default(cuid())

  dealId                String    @unique
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contractPrice         Decimal?  @db.Decimal(14, 2)
  currentPrice          Decimal?  @db.Decimal(14, 2)

  deposits              Deposit[]

  dueDiligenceBudget    Decimal?  @db.Decimal(14, 2)
  dueDiligenceSpent     Decimal?  @db.Decimal(14, 2)

  estimatedClosingCosts Decimal?  @db.Decimal(14, 2)
  actualClosingCosts    Decimal?  @db.Decimal(14, 2)

  lineItems             FinancialLineItem[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Deposit {
  id              String         @id @default(cuid())

  financialsId    String
  financials      DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  name            String
  amount          Decimal        @db.Decimal(14, 2)
  dueDate         DateTime

  status          DepositStatus  @default(SCHEDULED)
  paidDate        DateTime?
  paidAmount      Decimal?       @db.Decimal(14, 2)

  condition       String?
  notes           String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model FinancialLineItem {
  id              String         @id @default(cuid())

  financialsId    String
  financials      DealFinancials @relation(fields: [financialsId], references: [id], onDelete: Cascade)

  category        String
  name            String
  description     String?

  estimatedAmount Decimal?       @db.Decimal(14, 2)
  actualAmount    Decimal?       @db.Decimal(14, 2)

  vendor          String?
  invoiceNumber   String?
  paidDate        DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model UserPreferences {
  id                    String                @id @default(cuid())

  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications    Boolean               @default(true)
  taskReminders         Boolean               @default(true)
  deadlineAlerts        Boolean               @default(true)

  notificationFrequency NotificationFrequency @default(REALTIME)
  dailySummaryTime      String?
  weeklySummaryDay      Int?

  defaultDealView       String                @default("list")
  defaultTaskView       String                @default("list")
  timezone              String                @default("America/Los_Angeles")
  dateFormat            String                @default("MM/dd/yyyy")

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Notification {
  id          String    @id @default(cuid())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  title       String
  message     String
  link        String?

  isRead      Boolean   @default(false)
  readAt      DateTime?

  entityType  String?
  entityId    String?

  createdAt   DateTime  @default(now())
}

model ActivityLog {
  id          String    @id @default(cuid())

  userId      String?

  dealId      String?

  action      String
  entityType  String
  entityId    String
  entityName  String?

  changes     Json?
  metadata    Json?

  ipAddress   String?
  userAgent   String?

  createdAt   DateTime  @default(now())

  @@index([dealId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
